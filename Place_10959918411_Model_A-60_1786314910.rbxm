-- [FilteringEnabled] Server Scripts are IMPOSSIBLE to save]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[Moving]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties><Item class="TextBox" referent="33"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><Color3 name="PlaceholderColor3"><R>0.699999988079071</R><G>0.699999988079071</G><B>0.699999988079071</B></Color3><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[local RunService = game:GetService("RunService")
local val = game.ReplicatedStorage.Values
local aval = val.LastDoor
local npc = script.Parent
npc.RushNew.CFrame = workspace.Things.BackB.CFrame
npc.RushNew.Spawn:Play()


local function move(targetPart, respectAvalChanges)
	local promise = Instance.new("BindableEvent")
	local shouldRedirect = respectAvalChanges or false

	local function getTargetPosition()
		return targetPart.Position
	end

	local connection
	connection = RunService.Heartbeat:Connect(function(deltaTime)
		local npcSpeed = npc.Speed.Value
		local targetPosition = getTargetPosition()
		local currentPosition = npc.RushNew.Position
		local direction = (targetPosition - currentPosition).Unit
		local distanceToMove = npcSpeed * deltaTime
		local newPosition = currentPosition + direction * distanceToMove
		npc.RushNew.CFrame = CFrame.new(newPosition)

		local distanceToTarget = (newPosition - targetPosition).Magnitude
		if distanceToTarget < 6 then
			connection:Disconnect()
			promise:Fire()
		end
	end)

	local avalChangedConnection
	if shouldRedirect then
		avalChangedConnection = aval.Changed:Connect(function()
			targetPart = aval.Value.Parent.middle
		end)
	end

	promise.Event:Wait()
	if avalChangedConnection then
		avalChangedConnection:Disconnect() 
	end
end

local w = workspace.Things
-- goes to the middle of the room, waits 2 seconds then gets destroyed
move(aval.Value.Parent.middle, true)
wait(2)
npc:Destroy()]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties><Item class="ObjectValue" referent="34"><Properties><Ref name="Value">33</Ref><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SaveChangesTo]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties></Item><Item class="LocalScript" referent="35"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

